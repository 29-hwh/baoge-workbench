/* pages/profile/profile.wxss */

/* 报告长图离屏画布（导出时按内容动态设高度，平时移出屏幕） */
.report-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 600px;
}

.page {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

.hero {
  background: linear-gradient(135deg, #EEEDFE 0%, #E6F1FB 100%);
  padding: 32rpx;
}
.hero-row {
  display: flex;
  justify-content: space-around;
}
.hero-cell { text-align: center; }
.hero-num {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--c-primary);
  line-height: 1.1;
}
.hero-lab {
  font-size: 22rpx;
  color: var(--c-text-2);
  margin-top: 8rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 0.5px solid var(--c-divider);
  font-size: 28rpx;
}
.kv:last-child { border-bottom: none; }
.k { color: var(--c-text-2); }
.v { font-weight: 500; }

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}
.tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--c-primary);
  background: #EEEDFE;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.tag-cloud {
  color: #1A7F5A;
  background: #E2F5EC;
}

.tip {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.6;
  padding: 12rpx 0 20rpx;
  border-bottom: 0.5px solid var(--c-divider);
  margin-bottom: 8rpx;
}

.chevron {
  color: var(--c-text-3, #B4B2A9);
  font-size: 32rpx;
  margin-left: 16rpx;
}

.last-backup {
  font-size: 22rpx;
  color: var(--c-text-2);
  padding-top: 18rpx;
}
.last-backup.warn {
  color: #BA7517;
}

.backup-now {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
  background: #BA7517;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.backup-now:active { opacity: 0.88; }

.warn-tip {
  color: #BA7517;
  border-bottom-color: rgba(186,117,23,0.3);
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 0.5px solid var(--c-divider);
}
.setting-row:last-child { border-bottom: none; }
.setting-info { flex: 1; }
.setting-name {
  font-size: 28rpx;
  font-weight: 500;
}
.setting-name.danger { color: var(--c-today); }

.about {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--c-text-2);
}

/* 一键备份：最显眼的主操作 */
.backup-cta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #534AB7 0%, #6C63D6 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
}
.backup-cta:active { opacity: 0.9; }
.cta-icon { font-size: 40rpx; }
.cta-main { flex: 1; min-width: 0; }
.cta-title { font-size: 30rpx; font-weight: 600; }
.cta-sub { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.cta-go { font-size: 34rpx; opacity: 0.85; }
/* ===== 数据瘦身 ===== */
.clean-box { padding-top: 8rpx; }

.clean-total {
  display: flex; flex-direction: column; gap: 6rpx;
  padding: 20rpx 22rpx; border-radius: 14rpx;
  background: rgba(83,74,183,0.08);
  margin-bottom: 16rpx;
}
.clean-total.warn { background: rgba(163,45,45,0.12); }
.clean-total-num { font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.clean-total.warn .clean-total-num { color: #A32D2D; }
.clean-total-tip { font-size: 22rpx; color: var(--c-text-2); line-height: 1.5; }
.clean-total.warn .clean-total-tip { color: #A32D2D; }

.clean-action {
  background: var(--c-primary); color: #fff; text-align: center;
  font-size: 28rpx; font-weight: 500; padding: 20rpx 0;
  border-radius: 14rpx; margin-bottom: 18rpx;
}
.clean-action:active { opacity: 0.88; }

.clean-list { border-top: 0.5px solid var(--c-divider); }
.clean-row { padding: 20rpx 0; border-bottom: 0.5px solid var(--c-divider); }
.clean-row:active { opacity: 0.66; }
.clean-row-top { display: flex; align-items: baseline; justify-content: space-between; }
.clean-name { font-size: 28rpx; color: var(--c-text); font-weight: 500; }
.clean-size { font-size: 24rpx; color: var(--c-text-2); }
.clean-bar {
  height: 8rpx; background: var(--c-divider);
  border-radius: 999rpx; margin: 12rpx 0 8rpx; overflow: hidden;
}
.clean-bar-in { height: 100%; background: var(--c-primary); border-radius: 999rpx; }
.clean-row-sub { font-size: 22rpx; color: var(--c-text-3, #B4B2A9); }
