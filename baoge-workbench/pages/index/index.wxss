/* pages/index/index.wxss */

.page {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.greet {
  font-size: 40rpx;
  font-weight: 500;
  margin-top: 6rpx;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FAEEDA, #FAECE7);
  border: 0.5px solid var(--c-divider);
}

/* 卡片标题右侧操作按钮（＋ 记一笔 / ＋ 添加）：主色胶囊按钮
   - 配色：主色淡底 + 同色描边 + 主色文字，与卡片/进度条的圆角与过渡节奏一致
   - 热区：min-height 60rpx + 上下 padding 14rpx ≈ 88rpx 总高（约 44px），满足移动端可点击区域
   - 反馈：hover-class="add-hover"（小程序原生按压态，最可靠）+ :active 兜底桌面端 */
.card-title .add {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 60rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(83, 74, 183, 0.08);          /* 主色 #534AB7 的 8% 淡底 */
  border: 1rpx solid rgba(83, 74, 183, 0.22);
  box-shadow: 0 2rpx 8rpx rgba(83, 74, 183, 0.10);
  color: var(--c-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
  transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.15s ease;
}
.card-title .add .add-ico { font-size: 28rpx; font-weight: 700; line-height: 1; }
/* 按压：填充主色 + 白字 + 轻微缩放（点击行为不变，仅视觉反馈） */
.card-title .add.add-hover,
.card-title .add:active {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(83, 74, 183, 0.28);
  transform: scale(0.96);
}
/* 暗色主题：沿用全局暗色规范（主色 18% 淡底 + #B6ACFF 亮紫字，对比度 6.09:1） */
.theme-dark .card-title .add {
  background: rgba(138, 123, 255, 0.18);
  border-color: rgba(138, 123, 255, 0.38);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
  color: #B6ACFF;
}
.theme-dark .card-title .add.add-hover,
.theme-dark .card-title .add:active {
  background: var(--c-primary);
  border-color: var(--c-primary);
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(138, 123, 255, 0.32);
}

.todo {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 0.5px solid var(--c-divider);
}
.todo:last-child { border-bottom: none; padding-bottom: 0; }
.todo.done .todo-title { color: var(--c-text-3); text-decoration: line-through; }

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 1px solid var(--c-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: transparent;
}
.check.checked {
  background: var(--c-learning);
  border-color: var(--c-learning);
  color: #fff;
}

.todo-body { flex: 1; min-width: 0; }
.todo-title {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}
.todo-desc {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 4rpx;
}

.src-pill {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* overview */
.overview {
  display: flex;
  gap: 16rpx;
}
.ov-item {
  flex: 1;
  background: var(--c-bg);
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
}
.ov-label {
  font-size: 22rpx;
  color: var(--c-text-2);
  margin-bottom: 8rpx;
}
.ov-num {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.ov-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--c-text-3);
  margin-left: 4rpx;
}
.ov-sub {
  font-size: 20rpx;
  color: var(--c-text-3);
  margin: -4rpx 0 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 日期切换栏 ===== */
.datebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}
.date-nav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--c-card);
  border: 0.5px solid var(--c-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--c-text-2);
}
.date-center { text-align: center; flex: 1; }
.date-label {
  font-size: 32rpx;
  font-weight: 500;
}
.jump-today, .muted-date {
  font-size: 22rpx;
  color: var(--c-primary);
  margin-top: 4rpx;
}
.muted-date { color: var(--c-text-3); }

.src-pill.manual {
  background: #F1EFE8;
  color: #5F5E5A;
}

/* 待办手势提示 */
.todo-tip {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid var(--c-divider);
  text-align: center;
  font-size: 20rpx;
  color: var(--c-text-3);
}

/* ===== 倒计时卡片 ===== */
.cd-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 0.5px solid var(--c-divider);
}
.cd-item:last-child { border-bottom: none; padding-bottom: 0; }
.cd-name {
  font-size: 30rpx;
  font-weight: 500;
}
.cd-tag {
  font-size: 20rpx;
  color: var(--c-primary);
  background: #EEEDFE;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 10rpx;
}
.cd-date {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-top: 4rpx;
}
.cd-info { flex: 1; min-width: 0; }
.cd-desc {
  font-size: 22rpx;
  color: var(--c-text-2);
  margin-top: 4rpx;
  word-break: break-all;
}
.cd-days { text-align: right; }
.cd-num {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--c-today);
}
.cd-unit {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-left: 4rpx;
}
.cd-days.cd-today .cd-num { color: var(--c-warning); }
.cd-days.cd-past .cd-unit { color: var(--c-text-3); }
.cd-days .cd-unit { font-size: 22rpx; }

/* ===== 半屏表单弹层（加待办 / 加倒计时；.mask 基座已上提 app.wxss）===== */
.form-sheet {
  width: 620rpx;
  max-height: 86vh;
  overflow-y: auto;
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 36rpx 36rpx 32rpx;
}
.fs-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
}
.fs-row {
  margin-bottom: 26rpx;
}
.fs-row.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fs-label {
  font-size: 24rpx;
  color: var(--c-text-2);
  margin-bottom: 10rpx;
}
.fs-req {
  color: #E24B4A;
  font-size: 20rpx;
  margin-left: 6rpx;
}
.fs-opt {
  color: var(--c-text-3);
  font-size: 20rpx;
  margin-left: 6rpx;
}
.fs-input {
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}
.fs-area {
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
}
.fs-date {
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--c-text-1);
}
.fs-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}
.fs-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.fs-btn.ghost {
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  color: var(--c-text-2);
}
.fs-btn.main {
  background: var(--c-primary);
  color: #fff;
}

/* ===== 周待办竖条卡片（紧凑） ===== */
.week-card { padding-top: 22rpx; padding-bottom: 22rpx; }
.week-grid {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 6rpx;
}
.wk-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 2rpx;
  border-radius: 10rpx;
}
.wk-cell.wk-today {
  background: rgba(226,75,74,0.06);
}
/* 周待办七列统一规格：所有天均为 56rpx×24rpx 浅灰胶囊，
   有任务日按"红(未完成)在上 / 绿(已完成)在下"双色堆叠，比例 = 红绿各占百分比 */
.wk-track {
  position: relative;
  height: 56rpx;
  width: 24rpx;
  border-radius: 999rpx;
  background: #ECEAE3;           /* 统一浅灰底，有/无任务一致 */
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;     /* 子段从底部堆叠：红段在上、绿段在下 */
}
.wk-green {
  width: 100%;
  background: var(--c-learning);   /* 绿 = 已完成占比 */
  border-radius: 4rpx;
  transition: height 0.3s ease;
}
.wk-red {
  width: 100%;
  background: var(--c-today);      /* 红 = 未完成占比 */
  opacity: 0.92;
  border-radius: 4rpx;
  transition: height 0.3s ease;
}
.wk-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 72rpx;
}
.wk-dchar {
  font-size: 20rpx;
  line-height: 1;
  height: 20rpx;
  color: var(--c-text-3);
}
.wk-today .wk-dchar {
  color: var(--c-today);
  font-weight: 600;
}
.wk-cell.wk-empty .wk-dchar { color: #cfccc3; }
.wk-count {
  min-width: 34rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(0,0,0,0.06);
  color: var(--c-text-2);
  font-size: 18rpx;
  font-weight: 600;
}
.wk-count.zero {
  background: transparent;
  color: #d9d6cd;
  font-size: 16rpx;
  font-weight: 400;
}
.wk-today .wk-count { background: rgba(226,75,74,0.12); color: var(--c-today); }
.wk-today .wk-count.zero { background: transparent; color: #d9d6cd; }

/* ===== 手动待办详情弹层 ===== */
.td-row { margin-bottom: 22rpx; }
.td-label {
  font-size: 22rpx;
  color: var(--c-text-3);
  margin-bottom: 8rpx;
}
.td-text {
  font-size: 28rpx;
  color: var(--c-text);
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  word-break: break-all;
  line-height: 1.5;
}
.td-state {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #F1EFE8;
  color: var(--c-text-3);
  vertical-align: middle;
}
.td-state.on { background: #E1F5EE; color: #0F6E56; }
.fs-btn.danger {
  background: transparent;
  border: 0.5px solid #E24B4A;
  color: #E24B4A;
}

/* ===== 分段切换（倒计时公历/农历 共用）===== */
.seg {
  display: inline-flex;
  background: var(--c-bg);
  border-radius: 999rpx;
  padding: 4rpx;
}
.seg-item {
  font-size: 22rpx;
  color: var(--c-text-2);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}
.seg-item.on {
  background: var(--c-primary);
  color: #fff;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.search-input {
  flex: 1;
  font-size: 24rpx;
}
.search-clear {
  font-size: 24rpx;
  color: var(--c-text-3);
  padding-left: 12rpx;
}

/* 重要星标 */
.imp-star {
  color: var(--c-warning);
  margin-right: 6rpx;
  font-size: 26rpx;
}
.todo.imp .todo-title { color: var(--c-warning); }
.td-state.imp { background: #FAECE7; color: #A32D2D; }
.star-toggle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--c-text-3);
}
.star-toggle.on { color: var(--c-warning); border-color: var(--c-warning); background: #FAECE7; }

/* 选中态边框同步高亮（本周待办点日期） */
.wk-cell.sel {
  border: 2rpx solid var(--c-today);
  background: rgba(226,75,74,0.08);
}

/* 读书目标日提醒条 */
.alert-bar {
  background: #FAECE7;
  color: #A32D2D;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}
.ov-item.alert { box-shadow: 0 0 0 2rpx rgba(226,75,74,0.4) inset; }

/* 空状态引导 */
.empty-guide {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.eg-btn {
  flex: 1;
  text-align: center;
  background: var(--c-bg);
  border: 0.5px solid var(--c-divider);
  border-radius: 12rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--c-text-2);
}

/* 完成激励 */
.celebrate {
  position: fixed;
  left: 50%;
  top: 40%;
  transform: translate(-50%, -50%) scale(2);
  font-size: 120rpx;
  z-index: 999;
  animation: pop 1.4s ease forwards;
  pointer-events: none;
}
@keyframes pop {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
  30% { opacity: 1; transform: translate(-50%, -50%) scale(2.2); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(2.6); }
}

/* ===== 日期快捷选择 chip（记一笔 + 顶部日期共用）===== */
.date-caret { font-size: 20rpx; color: var(--c-text-3); margin-left: 4rpx; }
.date-chips {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  overflow-x: auto;
  padding-bottom: 6rpx;
  white-space: nowrap;
}
.date-chips.wrap { flex-wrap: wrap; overflow-x: visible; white-space: normal; }
.date-chip {
  flex: 0 0 auto;
  min-width: 108rpx;
  border-radius: 14rpx;
  background: var(--c-bg);
  border: 1.5px solid var(--c-divider);
  padding: 14rpx 18rpx;
  text-align: center;
  position: relative;
  transition: all 0.15s ease;
}
.date-chips.wrap .date-chip { flex: 1 1 21%; }
.date-chip.on { background: var(--c-primary); border-color: var(--c-primary); }
.date-chip.on .dc-label,
.date-chip.on .dc-sub { color: #fff; }
.date-chip.today { border-color: var(--c-primary); }
.date-chip.today .dc-label { color: var(--c-primary); }
.date-chip.on.today .dc-label,
.date-chip.on.today .dc-sub { color: #fff; }
.date-chip.future .dc-label { color: var(--c-text-2); }
.dc-label { font-size: 24rpx; font-weight: 500; color: var(--c-text); line-height: 1.2; }
.dc-sub { font-size: 20rpx; color: var(--c-text-3); margin-top: 2rpx; }
/* 记一笔 · 日期芯片紧凑横排换行网格：窄屏每行 4 个共 3 行，宽屏自动更多列甚至 1 行；
   替代 scroll-view 横滑（横滑在部分环境会退化成整列堆叠、把表单撑高，保存按钮被推远） */
.date-chips.inline { margin-top: 4rpx; gap: 12rpx 10rpx; }
.date-chips.inline .date-chip { padding: 12rpx 6rpx 10rpx; }
.date-chips.inline .dc-label { font-size: 23rpx; }
.date-chips.inline .dc-sub { font-size: 19rpx; margin-top: 0; line-height: 1.3; }
/* ===== 选中态提权（可读性修复）=====
   原问题：.date-chip.future .dc-label 与 .date-chip.on .dc-label 优先级相同(0,2,1)，
   但 future 规则声明更靠后 → 选中「未来日期」时主文字被刷成次级灰(--c-text-2)，
   灰字压在紫底上对比度仅约 1.07:1，几乎不可读。
   修法：选中态用更高的选择器(0,3,1)统一给白字并加粗，确保压过 future/today 等修饰色。 */
.date-chip.on .dc-label,
.date-chip.on .dc-sub,
.date-chip.on.today .dc-label,
.date-chip.on.today .dc-sub,
.date-chip.on.future .dc-label,
.date-chip.on.future .dc-sub {
  color: #fff;
  font-weight: 600;
}
/* 暗色主题：主色偏亮(#8A7BFF)，白字对比约 3.3:1 偏弱 →
   在保持主色变量的前提下，给选中态底色叠一层半透明黑压暗，对比度提升到 ~7.9:1 */
.theme-dark .date-chip.on {
  background-image: linear-gradient(rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0.42));
}

/* ===== 空状态每日轮换激励语 ===== */
.empty-quote {
  margin: 18rpx 8rpx 4rpx;
  padding: 18rpx 22rpx;
  background: var(--c-bg);
  border-left: 6rpx solid var(--c-primary);
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}
/* ===== Round 9 新增：待办日绿点 / 其他日期 / 农历公历参考 / 自定义跳转 ===== */
.dot-todo {
  position: absolute;
  top: 8rpx; right: 8rpx;
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #2BBF6A;     /* 小绿点：当日有待办 */
  box-shadow: 0 0 0 4rpx rgba(43, 191, 106, 0.18);
}
.date-chip { position: relative; }   /* 绿点定位锚 */

.more-dates-toggle {
  margin: 8rpx 0 4rpx;
  display: inline-block;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: var(--c-primary);
  background: rgba(24, 95, 165, 0.08);
  border-radius: 999rpx;
}
.date-wheel { margin-top: 10rpx; padding: 14rpx 18rpx; font-size: 24rpx; color: var(--c-text-2); background: var(--c-bg); border-radius: 10rpx; }
.date-wheel.on { color: var(--c-primary); }

/* ===== Round 12：记一笔 · 下方自定义日期控件（简约/便捷/美观）===== */
.custom-date {
  margin-top: 12rpx;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 22rpx;
  background: var(--c-bg);
  border: 1.5px solid var(--c-divider);
  border-radius: 14rpx;
  transition: all 0.15s ease;
}
.custom-date.on {
  border-color: var(--c-primary);
  background: rgba(24, 95, 165, 0.06);
}
.cd-left { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: var(--c-text); }
.cd-clabel { font-weight: 500; }
.cd-right { font-size: 24rpx; color: var(--c-text-2); }
.custom-date.on .cd-right { color: var(--c-primary); font-weight: 600; }
.custom-date-tip {
  margin-top: 8rpx; font-size: 21rpx; color: var(--c-primary);
  background: rgba(24, 95, 165, 0.06); border-radius: 8rpx; padding: 8rpx 14rpx;
}
/* 倒计时卡片：农历小标签 */
.cd-lunar {
  margin-top: 4rpx;
  display: inline-block;
  font-size: 20rpx;
  color: var(--c-text-3);
  background: var(--c-bg);
  border: 1rpx solid var(--c-divider);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.lunar-solar-ref {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--c-text-3);   /* 灰色小字：公历参考 */
}
.cd-past-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C0392B;
}

.jump-row { margin-top: 18rpx; }
.jump-pick {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--c-text);
  background: var(--c-bg);
  border-radius: 10rpx;
  border: 1rpx dashed var(--c-border, rgba(0,0,0,0.12));
}

/* ===== Round 10：记一笔 · 其他日期小图标横排 ===== */
.more-icons {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  overflow-x: auto;
  padding-bottom: 6rpx;
  white-space: nowrap;
}
.more-icon {
  flex: 0 0 auto;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--c-bg);
  border: 1.5px solid var(--c-divider);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  transition: all 0.15s ease;
}
.more-icon .mi-d { font-size: 26rpx; font-weight: 600; line-height: 1; color: var(--c-text); }
.more-icon .mi-w { font-size: 18rpx; color: var(--c-text-3); margin-top: 2rpx; }
.more-icon.on { background: var(--c-primary); border-color: var(--c-primary); }
.more-icon.on .mi-d, .more-icon.on .mi-w { color: #fff; }
.more-icon.today { border-color: var(--c-primary); }
.more-icon.today .mi-d { color: var(--c-primary); }
.more-icon.on.today .mi-d, .more-icon.on.today .mi-w { color: #fff; }
.more-icon.past .mi-d { color: var(--c-text-3); }

/* ===== Round 10：倒计时 · 公历月历网格 ===== */
.cal { margin-top: 12rpx; background: var(--c-bg); border-radius: 14rpx; padding: 16rpx; }
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.cal-nav { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; background: var(--c-divider); color: var(--c-text); font-size: 36rpx; }
.cal-title { font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.cal-week { display: flex; }
.cal-wd { flex: 1; text-align: center; font-size: 22rpx; color: var(--c-text-3); padding: 6rpx 0; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%; height: 76rpx; line-height: 76rpx; text-align: center;
  font-size: 28rpx; color: var(--c-text); border-radius: 12rpx;
}
.cal-cell.empty { visibility: hidden; }
.cal-cell.today { color: var(--c-primary); font-weight: 700; }
.cal-cell.dis { color: var(--c-text-3); text-decoration: line-through; }
/* 选定日期：清晰方框标记（淡底 + 主色边框 + 主色文字）
   淡底原为硬编码蓝 rgba(24,95,165)，与主色(紫)不同色系，且暗色主题下几乎不可见 → 统一为主色系淡底 */
.cal-cell.sel {
  background: rgba(83, 74, 183, 0.10);   /* 浅色主题：主色 #534AB7 的 10% 淡底 */
  color: var(--c-primary);
  font-weight: 700;
  border: 2rpx solid var(--c-primary);
  box-sizing: border-box;
}
.cal-cell:active { background: rgba(24,95,165,0.12); }
/* 暗色主题：日历选中格沿用全局暗色规范（同 app.wxss .theme-dark .tag.primary：
   主色 18% 淡底 + #B6ACFF 亮紫字），对比度 6.09:1（改动前 4.53:1） */
.theme-dark .cal-cell.sel { background: rgba(138, 123, 255, 0.18); color: #B6ACFF; }
.cd-sel-preview { margin-top: 12rpx; font-size: 24rpx; color: var(--c-primary); text-align: center; }

/* 记一笔 · 内联小日历（更紧凑，便于在表单内快速点选自定义日期，替代原生滚轮） */
.cal.mini { margin-top: 12rpx; padding: 12rpx; }
.cal.mini .cal-head { margin-bottom: 8rpx; }
.cal.mini .cal-nav { width: 48rpx; height: 48rpx; line-height: 48rpx; font-size: 32rpx; }
.cal.mini .cal-title { font-size: 26rpx; }
.cal.mini .cal-cell { height: 64rpx; line-height: 64rpx; font-size: 26rpx; }

/* ===== Round 10：倒计时 · 农历选择器高度修复（修复"无法选中"）===== */
.lunar-picker { display: flex; margin-top: 12rpx; }
.lp-view { flex: 1; height: 360rpx; }
.lp-col { text-align: center; line-height: 72rpx; font-size: 26rpx; color: var(--c-text); }
.lunar-preview { margin-top: 12rpx; font-size: 28rpx; font-weight: 600; color: var(--c-text); text-align: center; }
/* 农历选择器顶部：对应公历日期（显眼位置） */
.lunar-top {
  margin-top: 4rpx;
  padding: 16rpx 20rpx;
  background: rgba(24, 95, 165, 0.08);
  border: 1rpx solid rgba(24, 95, 165, 0.18);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-primary);
  text-align: center;
}
/* 公历选择器顶部：当前选中的公历日期（显眼位置，需求：选定日期放上方） */
.solar-top {
  margin-top: 4rpx;
  padding: 18rpx 20rpx;
  background: rgba(24, 95, 165, 0.10);
  border: 1.5rpx solid rgba(24, 95, 165, 0.28);
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-primary);
  text-align: center;
}

/* ===== 桌面 / 宽屏适配：rpx 会随窗口宽度等比放大，宽屏上把表单弹层限宽居中，避免横向过宽 ===== */
@media (min-width: 700px) {
  .form-sheet { width: 620px; max-width: 92vw; }
}
